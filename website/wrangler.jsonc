{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dayline-website",
  "compatibility_date": "2026-07-18",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/worker.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"],
  },
  "preview_urls": true,
  "exports": {
    "FeedbackAttachmentStore": {
      "type": "durable-object",
      "storage": "sqlite",
    },
    "FeedbackRateLimiter": {
      "type": "durable-object",
      "storage": "sqlite",
    },
  },
  "ratelimits": [
    {
      "name": "FEEDBACK_RATE_LIMIT",
      "namespace_id": "81080402",
      "simple": {
        "limit": 2,
        "period": 60,
      },
    },
  ],
  "routes": [
    {
      "pattern": "dayline.robin.build",
      "custom_domain": true,
    },
  ],
  "observability": {
    "enabled": true,
  },
}
