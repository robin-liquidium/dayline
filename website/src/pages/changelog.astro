---
import { changelog } from "../changelog";
import ReleaseEntry from "../components/ReleaseEntry.astro";
import Site from "../layouts/Site.astro";
---

<Site
  title="Changelog: what’s new in Dayline"
  description="Every new feature, improvement and fix in Dayline, release by release."
  support={false}
>
  <main id="main" class="rb-prose rb-shell">
    <h1>Changelog</h1>
    <p class="rb-lede">
      Every feature, improvement and fix, one quiet release at a time.
    </p>
    {changelog.releases.map((release, index) => (
      <ReleaseEntry release={release} isLatest={index === 0} />
    ))}
  </main>
</Site>
