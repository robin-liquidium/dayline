---
interface Props {
  command: string;
}
const { command } = Astro.props;
---

<div class="codebox">
  <code>{command}</code>
  <button
    type="button"
    data-copy-command={command}
    aria-label="Copy install command"
  >
    <svg class="copy" viewBox="0 0 24 24" aria-hidden="true">
      <rect x="9" y="9" width="12" height="12" rx="2.5"></rect>
      <path d="M5 15H4.5A1.5 1.5 0 0 1 3 13.5v-9A1.5 1.5 0 0 1 4.5 3h9A1.5 1.5 0 0 1 15 4.5V5"></path>
    </svg>
    <svg class="check" viewBox="0 0 24 24" aria-hidden="true">
      <path d="m5 12.5 4.5 4.5L19 7.5"></path>
    </svg>
  </button>
  <span
    class="rb-visually-hidden"
    role="status"
    data-copy-command-status
  ></span>
</div>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>(
    "[data-copy-command]",
  )) {
    const status = button.parentElement?.querySelector<HTMLElement>(
      "[data-copy-command-status]",
    );
    let timer: ReturnType<typeof setTimeout> | undefined;
    button.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.copyCommand ?? "");
      } catch {
        if (status) status.textContent = "Couldn’t copy the command.";
        return;
      }
      if (status) status.textContent = "Install command copied.";
      button.dataset.copied = "";
      clearTimeout(timer);
      timer = setTimeout(() => delete button.dataset.copied, 1600);
    });
  }
</script>
