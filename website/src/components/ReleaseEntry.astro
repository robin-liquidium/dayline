---
import type { ChangelogRelease } from "../changelog";
import { formatChangelogDate } from "../changelog";

interface Props {
  release: ChangelogRelease;
  isLatest: boolean;
}
const { release, isLatest } = Astro.props;
const groups = [
  { title: "New", items: release.new },
  { title: "Improvements and fixes", items: release.fixed },
].filter((group) => group.items?.length);
---

<section class="rb-release">
  <div class="rb-release-head">
    <h2>
      Version {release.version}
      {isLatest && <span class="latest">Latest</span>}
    </h2>
    <time datetime={release.date}>{formatChangelogDate(release.date)}</time>
  </div>
  {groups.map((group) => (
    <div class="release-group">
      <h3>{group.title}</h3>
      {group.items?.map((item) => (
        <p>
          {item.title && <strong>{item.title}. </strong>}
          {item.text}
        </p>
      ))}
    </div>
  ))}
</section>
