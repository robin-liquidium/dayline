---
import type { ChangelogRelease } from "../changelog";
import { formatChangelogDate } from "../changelog";
import ItemSection from "./ItemSection.astro";

interface Props {
  release: ChangelogRelease;
  isLatest: boolean;
  isFirst: boolean;
}
const { release, isLatest, isFirst } = Astro.props;
---

<li class={isFirst ? "" : "border-t border-line pt-12"}>
  <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
    <h2 class="font-display text-3xl tracking-tight text-ink">
      {release.version}
    </h2>
    {isLatest ? (
      <span class="font-display text-lg italic text-ember">Latest</span>
    ) : null}
    <time class="text-sm text-mute" datetime={release.date}>
      {formatChangelogDate(release.date)}
    </time>
  </div>

  <div class="mt-5 space-y-6">
    {release.new?.length ? (
      <ItemSection title="New features" items={release.new} />
    ) : null}
    {release.fixed?.length ? (
      <ItemSection title="Improvements & bug fixes" items={release.fixed} />
    ) : null}
  </div>
</li>
