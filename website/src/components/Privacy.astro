---
const rows = [
  { label: "OAuth tokens in the macOS Keychain", on: true },
  { label: "Secure sign-in, no client secrets", on: true },
  { label: "Direct Google, Linear and GitHub connections", on: true },
  { label: "Notes stored only on your Mac", on: true },
  { label: "Analytics and tracking", on: false },
  { label: "Your data routed through a Dayline server", on: false },
];
---

<ul class="toggles" aria-label="How Dayline handles your data">
  {rows.map((row) => (
    <li>
      <span>{row.label}</span>
      <span class:list={["toggle", { on: row.on }]}>
        <span class="rb-visually-hidden">{row.on ? "On" : "Off"}</span>
      </span>
    </li>
  ))}
</ul>
