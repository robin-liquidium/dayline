---
import Page from "@robin-build/landing-kit/Page.astro";
import type { Site } from "@robin-build/landing-kit/projects";
import "@robin-build/landing-kit/design.css";
import { changelog } from "../changelog";
import { site as dayline } from "../site";
import "../styles.css";

interface Props {
  title?: string;
  description?: string;
  /** Show the donation addresses. Off on legal and changelog pages. */
  support?: boolean;
  noindex?: boolean;
}
const {
  title = "Dayline: your calendar, issues and notes in the Mac menu bar",
  description = "Dayline is a free, open-source Mac menu bar app for Google Calendar, Linear and GitHub issues, Apple Reminders and local notes. No account, no tracking.",
  support = true,
  noindex,
} = Astro.props;
const site: Site = {
  id: "dayline",
  name: "Dayline",
  url: "https://dayline.robin.build",
  icon: "/images/icon-256.webp",
  themeColor: { light: "#f3f2f0", dark: "#0b0a0e" },
  ogImage: "https://dayline.robin.build/images/og.png?v=2",
  ogImageAlt: `Dayline. ${dayline.tagline}`,
  nav: [
    { label: "Features", href: "/#features" },
    { label: "Privacy", href: "/#privacy" },
    { label: "Questions", href: "/#questions" },
    { label: "Changelog", href: "/changelog" },
  ],
  cta: { label: "Download", href: dayline.downloadUrl },
  footerLinks: [
    { label: "Privacy", href: "/privacy" },
    { label: "Terms", href: "/terms" },
    { label: "Changelog", href: "/changelog" },
    { label: "GitHub", href: dayline.githubUrl },
  ],
  support,
  app: {
    operatingSystem: "macOS 26 or later",
    category: "ProductivityApplication",
    downloadUrl: dayline.downloadUrl,
    version: changelog.releases[0]?.version,
    screenshot: "/images/dayline-menu-overview.webp",
  },
};
---

<Page site={site} title={title} description={description} noindex={noindex}>
  <slot />
</Page>
