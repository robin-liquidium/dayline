---
import Site from "./Site.astro";

interface Props {
  title: string;
  summary: string;
  updated: string;
  description: string;
}
const { title, summary, updated, description } = Astro.props;
---

<Site title={`${title} · Dayline`} description={description} support={false}>
  <main id="main" class="rb-prose rb-shell">
    <h1>{title}</h1>
    <p class="rb-lede">{summary}</p>
    <p>Last updated {updated}</p>
    <slot />
  </main>
</Site>
