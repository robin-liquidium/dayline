{
  "name": "dayline-website",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "bun run build && wrangler dev",
    "deploy": "bun run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "test": "bun test",
    "lint": "bun lint --no-script",
    "lint:fix": "bun lint --no-script --fix",
    "fmt": "bun fmt --no-script && prettier --write 'src/**/*.astro'",
    "fmt:check": "bun fmt --check --no-script && prettier --check 'src/**/*.astro'",
    "check": "bun check --no-script && astro check"
  },
  "dependencies": {
    "@robin-build/landing-kit": "github:robin-liquidium/landing-kit#v1.1.1",
    "astro": "7.4.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@types/bun": "^1.3.14",
    "bun": "1.4.4-canary.20261102.1",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "typescript": "7",
    "wrangler": "^4.156.2",
    "@astrojs/sitemap": "3.7.4"
  }
}
